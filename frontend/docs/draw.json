{
  "screen": "DrawWithAI",
  "route": "/draw",
  "owner": "Frontend-1 (canvas) + Frontend-2 (chat)",
  "figmaFrame": "Screens / Draw / Canvas + AI",
  "layout": "toolbar(left) + canvas(center 70%) + sidebar(right 30%)",
  "components": [
    {
      "id": "toolbar",
      "type": "Toolbar",
      "position": "left",
      "orientation": "vertical",
      "children": [
        { "id": "brush", "type": "IconButton", "icon": "brush" },
        { "id": "eraser", "type": "IconButton", "icon": "eraser" },
        { "id": "color", "type": "ColorPicker" },
        { "id": "undo", "type": "IconButton", "icon": "undo" },
        { "id": "redo", "type": "IconButton", "icon": "redo" }
      ]
    },
    {
      "id": "canvas",
      "type": "KonvaStage",
      "width": "70%",
      "features": ["layers", "save-json", "export-png"],
      "background": "#FFFFFF"
    },
    {
      "id": "sidebar",
      "type": "SidePanel",
      "width": "30%",
      "children": [
        { "id": "chat", "type": "AIChat", "placeholder": "Спроси ИИ..." },
        {
          "id": "actions",
          "type": "Column",
          "children": [
            { "id": "btn-save", "type": "Button", "variant": "warning", "text": "Сохранить", "action": "saveState" },
            { "id": "btn-export", "type": "Button", "variant": "primary", "text": "В галерею", "action": "exportPNG" },
            { "id": "btn-menu", "type": "Button", "variant": "ghost", "text": "Меню", "action": "openDrawer" }
          ]
        }
      ]
    }
  ],
  "notes": "Konva.js, Zustand для истории, AI SDK для чата"
}