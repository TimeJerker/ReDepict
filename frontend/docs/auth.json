{
  "screen": "Auth",
  "route": "/login",
  "owner": "Frontend-1",
  "figmaFrame": "Screens / Auth / Login",
  "layout": "centered-card",
  "components": [
    {
      "id": "auth-card",
      "type": "Card",
      "position": "center",
      "width": 400,
      "padding": 32,
      "children": [
        { "id": "logo", "type": "Image", "src": "logo.svg", "size": 64, "align": "center" },
        { "id": "title", "type": "Heading", "level": 1, "text": "Вход в приложение", "align": "center" },
        { "id": "email", "type": "Input", "label": "Email", "placeholder": "you@mail.com", "validation": "email" },
        { "id": "password", "type": "Input", "label": "Пароль", "inputType": "password", "validation": "min:6" },
        { "id": "btn-login", "type": "Button", "variant": "primary", "text": "Войти", "action": "go:/" },
        { "id": "btn-register", "type": "Button", "variant": "ghost", "text": "Регистрация", "action": "go:/register" }
      ]
    }
  ],
  "notes": "Валидация Zod. Ошибки — Toast."
}