{
  "screen": "History",
  "route": "/history",
  "owner": "Frontend-3",
  "figmaFrame": "Screens / History / List",
  "layout": "header + filters + works-list + footer",
  "components": [
    {
      "id": "header",
      "type": "Header",
      "reuse": "home.header"
    },
    {
      "id": "filters",
      "type": "Row",
      "children": [
        { "id": "search", "type": "Input", "placeholder": "Поиск по работам" },
        { "id": "sort", "type": "Select", "options": ["Новые", "Старые", "С лучшими оценками"] }
      ]
    },
    {
      "id": "works-list",
      "type": "List",
      "gap": 16,
      "item": {
        "type": "WorkCard",
        "children": [
          { "id": "thumb", "type": "Image", "size": 120 },
          { "id": "title", "type": "Caption", "text": "Рисунок от 12 мая" },
          { "id": "date", "type": "Caption", "text": "12.05.2025" },
          { "id": "rating", "type": "Badge", "text": "8/10" },
          { "id": "btn-open", "type": "Button", "variant": "ghost", "text": "Открыть разбор", "action": "go:/work/:id" }
        ]
      }
    },
    {
      "id": "empty-state",
      "type": "EmptyState",
      "visible": "when works-list is empty",
      "children": [
        { "id": "empty-icon", "type": "Icon", "name": "image-off" },
        { "id": "empty-title", "type": "Heading", "text": "У вас пока нет работ" },
        { "id": "empty-text", "type": "Paragraph", "text": "Загрузите первый рисунок, чтобы получить разбор от ИИ" },
        { "id": "btn-upload", "type": "Button", "variant": "primary", "text": "Загрузить рисунок", "action": "go:/upload" }
      ]
    },
    {
      "id": "footer",
      "type": "Footer",
      "reuse": "home.footer"
    }
  ]
}