{
  "screen": "Home",
  "route": "/",
  "owner": "Frontend-2",
  "figmaFrame": "Screens / Home / Main",
  "layout": "header + hero + features + footer",
  "components": [
    {
      "id": "header",
      "type": "Header",
      "children": [
        { "id": "logo", "type": "Logo", "link": "/" },
        { "id": "nav", "type": "Nav", "items": ["Рисовать", "Галерея", "Помощь ИИ"] },
        { "id": "user-avatar", "type": "Avatar", "menu": ["Профиль", "Выход"] }
      ]
    },
    {
      "id": "hero",
      "type": "Section",
      "align": "center",
      "children": [
        { "id": "h1", "type": "Heading", "level": 1, "text": "Нарисуй что-то классное" },
        { "id": "subtitle", "type": "Paragraph", "text": "ИИ поможет, подскажет и вдохновит" },
        { "id": "btn-start", "type": "Button", "variant": "primary", "text": "Начать рисовать", "action": "go:/draw" }
      ]
    },
    {
      "id": "features",
      "type": "Grid",
      "columns": 3,
      "gap": 24,
      "cards": [
        { "icon": "brush", "title": "Своя кисть", "text": "Рисуй как хочешь" },
        { "icon": "sparkles", "title": "Помощь ИИ", "text": "Советы в реальном времени" },
        { "icon": "image", "title": "Галерея", "text": "Смотри работы других" }
      ]
    },
    { "id": "footer", "type": "Footer", "content": "© 2025 ArtApp" }
  ]
}