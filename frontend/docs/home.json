{
  "screen": "Home",
  "route": "/",
  "owner": "Frontend-2",
  "figmaFrame": "Screens / Home / Main",
  "layout": "header + hero + how-it-works + footer",
  "components": [
    {
      "id": "header",
      "type": "Header",
      "children": [
        { "id": "logo", "type": "Logo", "link": "/" },
        {
          "id": "nav",
          "type": "Nav",
          "children": [
            {
              "id": "btn-upload-nav",
              "type": "FilePicker",
              "variant": "ghost",
              "text": "Загрузить",
              "accept": "image/png, image/jpeg",
              "maxSize": 10485760,
              "requireAuth": true,
              "action": "onFileSelected:go:/analysis"
            },
            {
              "id": "btn-history",
              "type": "Button",
              "variant": "ghost",
              "icon": "clock",
              "text": "История",
              "requireAuth": true,
              "action": "go:/analysis"
            }
          ]
        },
        {
          "id": "user-avatar",
          "type": "Avatar",
          "requireAuth": true,
          "fallbackIcon": "user",
          "menu": [
            {
              "id": "btn-profile",
              "type": "Button",
              "variant": "ghost",
              "icon": "user",
              "text": "Профиль",
              "requireAuth": true,
              "action": "go:/history"
            },
            {
              "id": "btn-logout",
              "type": "Button",
              "variant": "danger",
              "icon": "logout",
              "text": "Выход",
              "requireAuth": true,
              "action": "logout:/login"
            }
          ]
        }
      ]
    },
    {
      "id": "hero",
      "type": "Section",
      "align": "center",
      "children": [
        {
          "id": "h1",
          "type": "Heading",
          "level": 1,
          "text": "Получите разбор своего рисунка от ИИ"
        },
        {
          "id": "subtitle",
          "type": "Paragraph",
          "text": "Загрузите фото — нейросеть укажет на ошибки и подскажет, как улучшить"
        },
        {
          "id": "btn-upload-hero",
          "type": "FilePicker",
          "variant": "primary",
          "text": "Загрузить рисунок",
          "accept": "image/png, image/jpeg",
          "maxSize": 10485760,
          "requireAuth": true,
          "action": "onFileSelected:go:/analysis"
        }
      ]
    },
    {
      "id": "how-it-works",
      "type": "Steps",
      "columns": 3,
      "gap": 24,
      "steps": [
        { "number": "1", "title": "Загрузите фото", "text": "PNG или JPG, до 10 МБ" },
        { "number": "2", "title": "ИИ анализирует", "text": "Разбор займёт несколько секунд" },
        { "number": "3", "title": "Получите советы", "text": "Что улучшить и как именно" }
      ]
    }
  ]
}